  demonSettings: {fileID: 11400000, guid: 36c2dd69476748a29c9fbc92093bc219, type: 2}
  generationSettings: {fileID: 11400000, guid: 8719fe57f7984c7d9730b7fac9dc8e04, type: 2}
  attackCooldown: 0.65
  checkpointEverySegments: 4
  shortJourneyScale: 0.2
  deathFadeSeconds: 1.8
  endingText: "\u4F60\u66FE\u8DD1\u5F97\u5F88\u5FEB\uFF0C\u4E5F\u66FE\u8D70\u5F97\u5F88\u6162\u3002\n\u90A3\u4E9B\u66FE\u7ECF\u62E6\u4F4F\u4F60\u7684\u5FC3\u9B54\uFF0C\u90FD\u5DF2\u7559\u5728\u8D70\u8FC7\u7684\u8DEF\u4E0A\u3002\n\n\u4F60\u628A\u90A3\u5F20\u65E7\u7EB8\u6162\u6162\u5C55\u5F00\u3002\n\u8FD9\u4E00\u6B21\uFF0C\u53EF\u4EE5\u5750\u4E0B\u6765\uFF0C\u770B\u770B\u6D77\u4E86\u3002"
