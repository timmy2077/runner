  stages:
  - stage: 0
    sceneName: Start
    title: "\u5A74\u513F\u671F"
    backgroundPrefab: {fileID: 6078105737564326606, guid: 67f838a77f087784fad3143c7e31a382, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u4E16\u754C\u5F88\u5927\uFF0C\u4F60\u8FD8\u5F88\u5C0F\u3002\u5411\u7740\u90A3\u675F\u5149\uFF0C\u6162\u6162\u722C\u3002\n\u9047\u5230\u5C01\u4F4F\u7684\u8DEF\uFF0C\u53EF\u4EE5\u505C\u4E0B\uFF0C\u7B49\u4E00\u4E2A\u95F4\u9699\u3002"
    deathText: "\u4F60\u8FD8\u6CA1\u5B66\u4F1A\u8D70\u8DEF\uFF0C\u5374\u5DF2\u7ECF\u5F88\u52AA\u529B\u5730\u9760\u8FD1\u8FD9\u4E2A\u4E16\u754C\u3002"
    departureText: "\u90A3\u675F\u5149\u6CA1\u6709\u53D8\u8FD1\uFF0C\u4F46\u4F60\u7EC8\u4E8E\u53EF\u4EE5\u7AD9\u8D77\u6765\u4E86\u3002"
    memories:
    - "\u7B2C\u4E00\u6B21\u62AC\u5934\u65F6\uFF0C\u90A3\u675F\u5149\u4E00\u76F4\u5728\u90A3\u91CC\u3002"
    - "\u6709\u4EBA\u7B49\u7740\u4F60\uFF0C\u5141\u8BB8\u4F60\u6162\u4E00\u70B9\u3002"
    - "\u539F\u6765\uFF0C\u8FD9\u4E48\u5C0F\u7684\u4E00\u6B65\uFF0C\u4E5F\u53EF\u4EE5\u8D70\u5230\u5F88\u8FDC\u3002"
    moveSpeed: 1.35
    sprintSpeed: 1.35
    jumpForce: 0
    doubleJumpForce: 0
    canSprint: 0
    canDoubleJump: 0
    canSlide: 0
    targetSeconds: 600
    demon: 0
    bossHealth: 1
  - stage: 1
    sceneName: Start 2
    title: "\u7AE5\u5E74\u671F"
    backgroundPrefab: {fileID: 4719031492499573503, guid: f6b70a7191dc1414daa9f0710372256e, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u4F60\u5B66\u4F1A\u4E86\u8DF3\u8DC3\uFF0C\u4E5F\u5B66\u4F1A\u4E86\u5954\u8DD1\u3002\n\u6709\u65F6\u8DEF\u4F1A\u6697\u4E0B\u6765\uFF0C\u5148\u770B\u6E05\u811A\u4E0B\uFF0C\u518D\u5411\u524D\u3002"
    deathText: "\u90A3\u4E00\u6B21\u6CA1\u80FD\u8DF3\u8FC7\u53BB\uFF0C\u4E0D\u4F1A\u6536\u8D70\u4F60\u518D\u6B21\u8D77\u8DF3\u7684\u52C7\u6C14\u3002"
    departureText: "\u4F60\u6298\u4E86\u4E00\u67B6\u7EB8\u98DE\u673A\uFF0C\u76F8\u4FE1\u5B83\u80FD\u98DE\u5230\u4E16\u754C\u7684\u53E6\u4E00\u8FB9\u3002"
    memories:
    - "\u7B2C\u4E00\u6B21\u79BB\u5F00\u5730\u9762\uFF0C\u98CE\u4ECE\u811A\u4E0B\u7ECF\u8FC7\u3002"
    - "\u4F60\u5BB3\u6015\u7684\u5F71\u5B50\uFF0C\u539F\u6765\u4E5F\u4F1A\u7559\u51FA\u4E00\u6761\u8DEF\u3002"
    - "\u90A3\u67B6\u7EB8\u98DE\u673A\uFF0C\u88C5\u4E0B\u4E86\u5F88\u5927\u7684\u613F\u671B\u3002"
    moveSpeed: 3.5
    sprintSpeed: 6
    jumpForce: 9
    doubleJumpForce: 0
    canSprint: 1
    canDoubleJump: 0
    canSlide: 1
    targetSeconds: 600
    demon: 1
    bossHealth: 12
  - stage: 2
    sceneName: Start 3
    title: "\u5C11\u5E74\u671F"
    backgroundPrefab: {fileID: 8462536129879381235, guid: d826c5fc2267c9a4583b44413a1f0b9f, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u8FD9\u662F\u4F60\u8DD1\u5F97\u6700\u5FEB\u7684\u5E74\u7EAA\u3002\n\u518D\u6309\u4E00\u6B21\u8DF3\u8DC3\uFF0C\u53EF\u4EE5\u5728\u7A7A\u4E2D\u501F\u4E00\u6B21\u529B\u3002\u98D8\u843D\u7684\u8BD5\u5377\uFF0C\u4E5F\u6709\u95F4\u9699\u3002"
    deathText: "\u4F60\u5DF2\u7ECF\u8DD1\u5F97\u5F88\u5FEB\u4E86\u3002\u5076\u5C14\u505C\u4E0B\u6765\uFF0C\u4E0D\u4EE3\u8868\u843D\u540E\u3002"
    departureText: "\u4F60\u4EE5\u4E3A\u53EF\u4EE5\u4E00\u76F4\u8FD9\u6837\u51B2\u523A\u3002\u76F4\u5230\u4E0B\u4E00\u7A0B\uFF0C\u811A\u6B65\u7B2C\u4E00\u6B21\u6162\u4E86\u4E0B\u6765\u3002"
    memories:
    - "\u4F60\u66FE\u4EE5\u4E3A\uFF0C\u53EA\u8981\u8DB3\u591F\u5FEB\uFF0C\u5C31\u80FD\u8FFD\u4E0A\u6240\u6709\u671F\u5F85\u3002"
    - "\u7EB8\u98DE\u673A\u63A0\u8FC7\u4E66\u9875\uFF0C\u66FF\u4F60\u770B\u4E86\u4E00\u773C\u7A97\u5916\u3002"
    - "\u90A3\u65F6\u7684\u98CE\u5F88\u5927\uFF0C\u4F60\u4E5F\u771F\u7684\u8DD1\u5F97\u5F88\u5FEB\u3002"
    moveSpeed: 6
    sprintSpeed: 9
    jumpForce: 10
    doubleJumpForce: 8
    canSprint: 1
    canDoubleJump: 1
    canSlide: 1
    targetSeconds: 600
    demon: 2
    bossHealth: 16
  - stage: 3
    sceneName: Start 4
    title: "\u9752\u5E74\u671F"
    backgroundPrefab: {fileID: 8462536129879381235, guid: 7ee4763597f7c1a4d86f4bbaede95c90, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u57CE\u5E02\u4E00\u76F4\u5411\u524D\u3002\u4F60\u53D1\u73B0\uFF0C\u6709\u4E9B\u8F66\uFF0C\u5DF2\u7ECF\u8D76\u4E0D\u4E0A\u4E86\u3002\n\u770B\u6E05\u8DEF\u6807\uFF0C\u7B49\u5F85\u4E00\u4E2A\u80FD\u901A\u8FC7\u7684\u65F6\u523B\u3002"
    deathText: "\u6CA1\u8D76\u4E0A\u8FD9\u4E00\u73ED\uFF0C\u4E5F\u4E0D\u610F\u5473\u7740\u8FD9\u4E00\u751F\u5DF2\u7ECF\u8FDF\u5230\u3002"
    departureText: "\u5730\u94C1\u5E26\u8D70\u4E86\u5F88\u591A\u4EBA\u3002\u4F60\u8BB0\u8D77\u90A3\u67B6\u7EB8\u98DE\u673A\uFF0C\u4E5F\u5F00\u59CB\u5B66\u4F1A\u7B49\u5F85\u3002"
    memories:
    - "\u539F\u6765\uFF0C\u5E76\u975E\u6BCF\u4E00\u73ED\u8F66\u90FD\u9700\u8981\u8FFD\u4E0A\u3002"
    - "\u8DEF\u53E3\u7684\u5149\uFF0C\u548C\u5C0F\u65F6\u5019\u7A97\u8FB9\u7684\u5149\u6709\u4E00\u70B9\u50CF\u3002"
    - "\u4F60\u6CA1\u6709\u627E\u5230\u6240\u6709\u7B54\u6848\uFF0C\u4F46\u4ECD\u7136\u8D70\u5230\u4E86\u8FD9\u91CC\u3002"
    moveSpeed: 4.5
    sprintSpeed: 4.5
    jumpForce: 9
    doubleJumpForce: 7
    canSprint: 0
    canDoubleJump: 1
    canSlide: 1
    targetSeconds: 600
    demon: 3
    bossHealth: 18
  - stage: 4
    sceneName: Start 5
    title: "\u4E2D\u5E74\u671F"
    backgroundPrefab: {fileID: 8462536129879381235, guid: b18f8942207b7504298d20d1d47295e8, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u5934\u9876\u7684\u91CD\u91CF\u8D8A\u6765\u8D8A\u8FD1\u3002\n\u7B49\u5B83\u62AC\u8D77\uFF0C\u518D\u8FC8\u4E00\u6B65\u3002\u6BCF\u4E00\u6B21\u843D\u7A33\uFF0C\u90FD\u7B97\u6570\u3002"
    deathText: "\u8FD9\u4E00\u6B21\uFF0C\u4F60\u53EA\u662F\u7D2F\u4E86\u3002\u4F60\u627F\u53D7\u8FC7\u7684\u91CD\u91CF\uFF0C\u4E0D\u4F1A\u56E0\u6B64\u88AB\u62B9\u53BB\u3002"
    departureText: "\u4F60\u7EC8\u4E8E\u5141\u8BB8\u81EA\u5DF1\u653E\u4E0B\u7247\u523B\u3002\u8FDC\u5904\uFF0C\u4F20\u6765\u4E86\u6D77\u7684\u58F0\u97F3\u3002"
    memories:
    - "\u6709\u4E9B\u91CD\u91CF\uFF0C\u6CA1\u6709\u4EBA\u770B\u89C1\uFF0C\u4F60\u5374\u4E00\u76F4\u5E26\u7740\u3002"
    - "\u4E00\u6B21\u843D\u7A33\uFF0C\u4E5F\u662F\u4E00\u79CD\u5411\u524D\u3002"
    - "\u4F60\u7ED9\u522B\u4EBA\u7559\u4E86\u4E00\u675F\u5149\uFF0C\u4E5F\u53EF\u4EE5\u4E3A\u81EA\u5DF1\u7559\u4E00\u4F1A\u513F\u3002"
    moveSpeed: 3
    sprintSpeed: 3
    jumpForce: 7.5
    doubleJumpForce: 0
    canSprint: 0
    canDoubleJump: 0
    canSlide: 1
    targetSeconds: 600
    demon: 4
    bossHealth: 20
  - stage: 5
    sceneName: Start 6
    title: "\u8001\u5E74\u671F"
    backgroundPrefab: {fileID: 6078105737564326606, guid: 67f838a77f087784fad3143c7e31a382, type: 3}
    groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
    obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
    introduction: "\u98CE\u6162\u4E86\uFF0C\u811A\u6B65\u4E5F\u6162\u4E86\u3002\n\u524D\u65B9\u6CA1\u6709\u9700\u8981\u8D76\u4E0A\u7684\u4EBA\u3002\u6CBF\u7740\u8FD9\u6BB5\u8DEF\uFF0C\u8D70\u5230\u53EF\u4EE5\u6B47\u811A\u7684\u5730\u65B9\u3002"
    deathText: "\u8FD9\u4E00\u8DEF\u5DF2\u7ECF\u5F88\u957F\u3002\u6B47\u4E00\u6B47\uFF0C\u518D\u53BB\u770B\u4E00\u773C\u5915\u9633\u3002"
    departureText: "\u4F60\u628A\u90A3\u5F20\u65E7\u7EB8\u6162\u6162\u5C55\u5F00\u3002\u6D77\u98CE\u66FF\u4F60\u7FFB\u5230\u4E86\u6700\u540E\u4E00\u9875\u3002"
    memories:
    - "\u4F60\u8FD8\u8BB0\u5F97\u7B2C\u4E00\u6B21\u62AC\u5934\u65F6\u7684\u90A3\u675F\u5149\u3002"
    - "\u7EB8\u98DE\u673A\u843D\u4E0B\u7684\u5730\u65B9\uFF0C\u4E5F\u53EF\u4EE5\u6210\u4E3A\u5F52\u5904\u3002"
    - "\u4F60\u7EC8\u4E8E\u6709\u65F6\u95F4\uFF0C\u542C\u5B8C\u4E00\u9635\u98CE\u3002"
    moveSpeed: 1.25
    sprintSpeed: 1.25
    jumpForce: 4.5
    doubleJumpForce: 0
    canSprint: 0
    canDoubleJump: 0
    canSlide: 0
    targetSeconds: 600
    demon: 5
    bossHealth: 1
  groundSprite: {fileID: 21300000, guid: 78d82ff435234a343a0f7c9b6412eb92, type: 3}
  obstacleSprite: {fileID: 21300000, guid: b4d0b2687bb73854987047640f2c3b50, type: 3}
