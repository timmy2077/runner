  events:
  - eventId: I01
    stage: 0
    title: "夜里的哭声"
    prompt: "夜里醒来，房间很黑，你听见门外熟悉的脚步声。"
    options:
    - optionId: I01_A
      answer: "哭出声，让他们听见"
      traitName: "被听见"
      plannedEffect: "障碍守护 +1 次"
      resultText: "你选择了“哭出声，让他们听见”，把这一刻记在了人生里。"
      narrativeFlag: ""
    - optionId: I01_B
      answer: "抱紧小被子，听一听"
      traitName: "熟悉的声音"
      plannedEffect: "预警提前 +0.10 秒"
      resultText: "你选择了“抱紧小被子，听一听”，把这一刻记在了人生里。"
      narrativeFlag: ""
    - optionId: I01_C
      answer: "朝门缝的光慢慢爬去"
      traitName: "向光而去"
      plannedEffect: "拾光半径 +0.30 米"
      resultText: "你选择了“朝门缝的光慢慢爬去”，把这一刻记在了人生里。"
      narrativeFlag: ""
  - eventId: I02
    stage: 0
    title: "滚远的玩具"
    prompt: "最喜欢的玩具滚到了桌脚后面，前方有一条窄窄的缝。"
